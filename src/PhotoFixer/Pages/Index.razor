@page "/"
@inject IJSRuntime JS

<PageTitle>PhotoFixer - compress photos to any KB size</PageTitle>

<header class="hero">
    <img src="logo.svg" alt="PhotoFixer logo" width="76" height="76" />
    <h1>PhotoFixer</h1>
    <p>Type the maximum KB a form allows. Your photo is compressed to fit under it - no crop, no stretch, proportions untouched.</p>
    <span class="privacy-pill">Runs fully in your browser &middot; your photo is never uploaded</span>
</header>

<main class="wrap">

    <section class="card">
        <h2><span class="step-dot">1</span> Choose a photo</h2>
        <div class="file-zone">
            <InputFile OnChange="OnFileChange" accept=".jpg,.jpeg,.png,.webp,.gif,.bmp,.avif,.heic,.heif,image/jpeg,image/png,image/webp,image/gif,image/bmp,image/avif,image/heic,image/heif" />
            <div><strong>JPG, PNG, WebP, GIF, BMP, AVIF or HEIC</strong>, up to 30 MB</div>
        </div>
        @if (sourceInfo is { } s)
        {
            <div class="file-info">Loaded: @FormatName(s.Format), @s.Width x @s.Height px, @Kb(s.Bytes)</div>
        }
    </section>

    <section class="card">
        <h2><span class="step-dot">2</span> Set the maximum size</h2>
        <div class="grid" style="grid-template-columns:1fr;">
            <label class="field">Max size (KB)
                <InputNumber @bind-Value="maxKb" placeholder="e.g. 200" />
                <small style="color:var(--muted); font-weight:500; display:block; margin-top:0.3rem;">Your photo keeps its proportions. Compression quality is lowered first; the resolution is reduced automatically only when quality alone cannot reach your target, and the tool always tells you when that happens.</small>
                <small style="color:var(--muted); font-weight:500; display:block; margin-top:0.3rem;">The result always comes out under your KB limit - a strict maximum, never an above-target file. Photos are saved as JPEG to reach small targets, and very small targets cost visible quality.</small>
            </label>
        </div>

        <button class="go" @onclick="ProcessAsync" disabled="@(sourceInfo is null || busy)">
            @(busy ? "Working..." : "Compress photo")
        </button>
        @if (error is { } err)
        {
            <div class="msg err">@err</div>
        }
    </section>

    @if (result is { Success: true } r)
    {
        <section class="card result">
            <h2><span class="step-dot">3</span> Check and download</h2>
            <img id="result-preview" alt="Compressed photo preview" />
            <div class="stats">
                <span class="stat">@r.OutputWidth x @r.OutputHeight px</span>
                <span class="stat">@r.OutputKb KB</span>
                @if (r.JpegQuality is { } q) { <span class="stat">JPEG quality @q</span> }
                <span class="stat">@(r.FileExtension == ".png" ? "PNG" : "JPEG")</span>
            </div>
            @foreach (var w in r.Warnings) { <div class="msg warn">@w</div> }
            @foreach (var n in r.Notes) { <div class="msg note">@n</div> }
            <button class="dl" @onclick="DownloadAsync">Download result</button>
        </section>
    }

    <footer>
        <b>Honest notes:</b> every form applies its own checks, so a file that meets the numbers
        can still be rejected by the destination site. Very small KB targets always cost quality.
        PhotoFixer runs on your device with WebAssembly; no account, no upload, no copy kept.
        <br /><b>&copy; 2026 Nelli. All rights reserved.</b> Unauthorized copying or redistribution is prohibited.
    </footer>
</main>

@code {
    private const long MaxFileBytes = 30L * 1024 * 1024;

    private SourceImage? sourceInfo;
    private int? maxKb;
    private ProcessResult? result;
    private string? error;
    private bool busy;
    private bool previewPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The preview <img> only exists after the result card renders, so the
        // blob URL must be set here, not in the click handler.
        if (previewPending && result?.OutputBytes is not null)
        {
            previewPending = false;
            await JS.InvokeVoidAsync("denelliPhotoFixer.setPreviewFromLast");
        }
    }

    private static string Kb(long bytes) => $"{Math.Round(bytes / 1000.0, 1)} KB";

    private static string FormatName(string mime) => mime switch
    {
        "image/png" => "PNG",
        "image/webp" => "WebP",
        "image/gif" => "GIF",
        "image/bmp" => "BMP",
        "image/avif" => "AVIF",
        "image/heic" => "HEIC",
        _ => "JPEG"
    };

    private sealed class ProbeDto { public int width { get; set; } public int height { get; set; } public string type { get; set; } = ""; public long size { get; set; } }

    // The file's bytes are read by JavaScript straight from the input element
    // (loadFromInput), never copied through .NET interop: fast and reliable.
    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        result = null; error = null; sourceInfo = null;
        var file = e.File;
        if (file.Size > MaxFileBytes)
        {
            error = "That photo is over 30 MB, which is too large for this tool.";
            return;
        }
        try
        {
            var p = await JS.InvokeAsync<ProbeDto>("denelliPhotoFixer.loadFromInput");
            if (p.size > MaxFileBytes)
            {
                error = "That photo is over 30 MB, which is too large for this tool.";
                return;
            }
            if (p.type is not ("image/jpeg" or "image/png" or "image/webp" or "image/gif" or "image/bmp" or "image/avif" or "image/heic"))
            {
                error = "That format is not supported. Use JPG, PNG, WebP, GIF, BMP, AVIF or HEIC.";
                return;
            }
            sourceInfo = new SourceImage(p.width, p.height, p.type, p.size);
        }
        catch
        {
            error = "That file is not a readable photo. Supported: JPG, PNG, WebP, GIF, BMP, AVIF, HEIC.";
            sourceInfo = null;
        }
    }

    private async Task ProcessAsync()
    {
        if (sourceInfo is null) return;
        busy = true; result = null; error = null;
        await Task.Yield();
        try
        {
            // KB-only compression: keep the source proportions (FitInside with no
            // dimension bounds) and let the engine search quality, shrinking only
            // as a last resort and always disclosing it. JPEG output: the only
            // format that can reliably honour a strict KB ceiling.
            var req = new ProcessRequest(null, null, maxKb, FitMode.FitInside, OutputFormat.Jpeg);
            result = await PhotoFixerEngine.ProcessAsync(sourceInfo!, req, new Services.BrowserCodecShamil(JS));
            if (result.Success)
                previewPending = true;
            else
                error = result.Error;
        }
        catch (Exception ex)
        {
            error = "Processing failed: " + ex.Message;
        }
        busy = false;
    }

    private async Task DownloadAsync()
    {
        if (result?.OutputBytes is null) return;
        var name = $"photofixer-{result.OutputWidth}x{result.OutputHeight}{result.FileExtension}";
        await JS.InvokeVoidAsync("denelliPhotoFixer.downloadLast", name);
    }
}
